# Server-only. Never prefix credentials with NEXT_PUBLIC_. Never commit .env.local.
# Use the intended Neon branch's pooled TLS connection; see docs/DATABASE.md.
DATABASE_URL=
# Optional direct Neon connection for migrations; falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Local API key for Vercel AI Gateway. On Vercel, supported OIDC may supply auth.
AI_GATEWAY_API_KEY=
# Explicit model choice, confirm availability in your Gateway account.
AI_GATEWAY_MODEL=openai/gpt-6.1-sol
# Public MCP address. Each user supplies their own credential at sign-in.
RCP_MCP_URL=https://rcp.tazalabs.ai/mcp
# Exact public origin, no trailing slash. HTTP allowed only for localhost.
APP_ORIGIN=http://localhost:3000
# 32 random bytes encoded as 64 hex characters. Keep stable and backed up securely.
# Generate securely; do not reuse the RCP token or database password as this key.
RCP_TOKEN_ENCRYPTION_KEY=
