{
  "name": "tz-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run check"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.125",
    "@ai-sdk/mcp": "2.0.83",
    "@ai-sdk/react": "4.0.156",
    "@neondatabase/serverless": "1.2.0",
    "ai": "7.0.152",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vercel": "65.2.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  }
}
